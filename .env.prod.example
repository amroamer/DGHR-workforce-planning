# ── Production env for the Azure VM deploy (docker-compose.prod.yml) ──
# On the VM: copy this to `.env`, fill in the secrets, then `chmod 600 .env`.
# NEVER commit the real .env.

# Public address Caddy serves and provisions TLS for.
#   Real domain or nip.io hostname  -> automatic HTTPS (Let's Encrypt):
#       SITE_ADDRESS=dghr.20-1-2-3.nip.io
#   IP / HTTP only (quickest, no cert):
#       SITE_ADDRESS=:80
SITE_ADDRESS=:80

# Postgres (runs as a container; data persists in the pgdata volume on the VM disk).
POSTGRES_USER=dghr
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=dghr

# Frontend API base. Leave EMPTY -> same-origin /api calls through Caddy (no CORS).
VITE_API_URL=

# AI layer (optional). The demo runs fully offline with the deterministic fallback.
ANTHROPIC_API_KEY=
DEMO_AI_MODE=fallback
MODEL_NAME=claude-sonnet-5

# Safety rail: keep false so a reseed refuses to wipe a populated DB.
ALLOW_DB_RESET=false

# Uvicorn worker processes in production.
WEB_CONCURRENCY=2
