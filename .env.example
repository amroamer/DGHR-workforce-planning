# Database
DATABASE_URL=postgresql+psycopg://dghr:dghr@postgres:5432/dghr
POSTGRES_USER=dghr
POSTGRES_PASSWORD=dghr
POSTGRES_DB=dghr

# CORS — frontend origin(s), comma-separated
# NOTE: host ports are offset (5183/8010/5544) to avoid collisions with sibling projects.
FRONTEND_ORIGIN=http://localhost:5183

# AI layer (SPEC §13) — all optional; demo runs fully without these
ANTHROPIC_API_KEY=
# "fallback" forces deterministic canned AI output (demo indistinguishable offline)
DEMO_AI_MODE=fallback
MODEL_NAME=claude-sonnet-5

# Frontend
VITE_API_URL=http://localhost:8010
